# Webflow export reference files (not part of the project)
from webflow/

# OS files
.DS_Store

# Python bytecode cache (scripts/)
__pycache__/

# Search Console service account key — never commit credentials
scripts/credentials/

# Fonts converted from woff2 for Pillow (Pin generation) — regenerated
# from the real fonts/*.woff2 source, never itself a source of truth
scripts/.font-cache/
